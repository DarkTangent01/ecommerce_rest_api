NODE_ENV=development
APP_PORT=5000
APP_IP_ADDRESS=127.0.0.1
APP_URL=http://localhost:5000
# Includes stack traces in 5xx responses. Never enable in production.
DEBUG_MODE=false
DB_URL=mongodb://127.0.0.1:27017/ecommerce_rest_api

# Secrets: required in production (>= 32 chars, all different). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty outside production, a random per-process value is used (tokens reset on restart).
JWT_SECRET=
REFRESH_SECRET=
WEBHOOK_SECRET=
SERVICE_JWT_SECRET=
SIGNED_URL_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Comma-separated. In production an empty list rejects all cross-origin browser requests.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
REQUEST_BODY_LIMIT=100kb
UPLOAD_MAX_BYTES=5242880
BCRYPT_ROUNDS=12
IDEMPOTENCY_TTL_HOURS=24
INVENTORY_RESERVATION_MINUTES=15
# How often expired, unpaid inventory reservations are released.
RESERVATION_SWEEP_SECONDS=60
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=1000
REDIS_URL=
QUEUE_BACKEND=memory
ADMIN_IP_ALLOWLIST=
ADMIN_IP_DENYLIST=
SIGNED_URL_TTL_SECONDS=300
DEFAULT_TENANT=default
REDIS_RATE_LIMIT_PREFIX=rl
OTEL_SERVICE_NAME=ecommerce-rest-api
ENABLE_QUERY_PROFILING=false
SEARCH_BACKEND=mongodb-text
